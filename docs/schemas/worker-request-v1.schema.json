{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kgmaker:worker-request-v1",
  "title": "kgmaker worker-request-v1",
  "type": "object",
  "required": [
    "protocol_version",
    "operation"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "handshake",
        "project",
        "analyze"
      ]
    },
    "root": {
      "type": "string"
    },
    "context": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kgmaker:build-manifest-v1",
  "title": "kgmaker build-manifest-v1",
  "type": "object",
  "required": [
    "schema_version",
    "build_id",
    "snapshot",
    "build_result",
    "contexts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "type": "string"
    },
    "snapshot": {
      "type": "object",
      "required": [
        "sources",
        "content_hash"
      ]
    },
    "build_result": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUCCESS",
            "FAILED",
            "PARTIAL",
            "TIMED_OUT",
            "CANCELLED",
            "TOOLCHAIN_UNAVAILABLE",
            "DEPENDENCY_UNAVAILABLE"
          ]
        }
      }
    },
    "toolchain_selection": {
      "type": ["object", "null"],
      "properties": {
        "selection": {"const": "EXPLICIT_JAVA_HOME"},
        "java_home": {"type": "string", "minLength": 1},
        "executables": {"type": "object"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "repo_id",
          "module",
          "source_set",
          "scope",
          "source_roots",
          "source_files",
          "classpath"
        ],
        "properties": {
          "generated_source_roots": {"type": "array", "items": {"type": "string"}},
          "generated_sources": {"type": "array", "items": {"type": "object"}},
          "build_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "compiler_options": {
            "type": "object",
            "properties": {
              "kotlin": {
                "type": "object",
                "required": ["schema_version", "status"],
                "properties": {
                  "schema_version": {"const": 1},
                  "status": {"enum": ["CAPTURED_CONFIGURATION", "PARTIAL", "NOT_OBSERVED"]},
                  "compiler_version": {"type": "string", "minLength": 1},
                  "language_version": {"type": "string", "minLength": 1},
                  "api_version": {"type": "string", "minLength": 1},
                  "jvm_target": {"type": "string", "minLength": 1},
                  "free_args": {"type": "array", "items": {"type": "string"}},
                  "plugins": {"type": "array", "items": {"type": "string"}},
                  "plugin_artifacts": {"type": "array", "items": {
                    "type": "object", "required": ["coordinates", "path", "sha256"],
                    "properties": {"coordinates": {"type": "string", "minLength": 1},
                      "path": {"type": "string", "minLength": 1},
                      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
                  "plugin_options": {"type": "array", "items": {"type": "string"}},
                  "opt_in": {"type": "array", "items": {"type": "string"}},
                  "java_parameters": {"type": "boolean"},
                  "all_warnings_as_errors": {"type": "boolean"},
                  "suppress_warnings": {"type": "boolean"},
                  "progressive": {"type": "boolean"}
                }
              }
            }
          },
          "toolchain": {"type": "object"},
          "parent": {"type": ["object", "null"]},
          "effective_dependencies": {"type": "array", "items": {"type": "object"}},
          "dependency_management": {"type": "array", "items": {"type": "object"}},
          "imported_boms": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
